
import yfinance as yf
import pandas as pd
import json
import os
from datetime import datetime, timezone, timedelta

IST = timezone(timedelta(hours=5, minutes=30))

CAPITAL = 5000
STOP_LOSS = 10
TARGET = 15
MAX_TRADES = 2
DAILY_LOSS_LIMIT = 20

STATE_FILE = "state.json"


def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r") as f:
            return json.load(f)

    return {
        "date": "",
        "trades": 0,
        "daily_loss": 0,
        "position": None,
        "last_candle": ""
    }


def save_state(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def run_bot():
    now = datetime.now(IST)
    today = now.strftime("%Y-%m-%d")

    if now.weekday() >= 5:
        print("Market closed: Weekend")
        return

    if not (now.hour > 9 or (now.hour == 9 and now.minute >= 15)):
        print("Market not open yet")
        return

    if now.hour > 15 or (now.hour == 15 and now.minute > 30):
        print("Market closed")
        return

    state = load_state()

    if state["date"] != today:
        state = {
            "date": today,
            "trades": 0,
            "daily_loss": 0,
            "position": None,
            "last_candle": ""
        }

    print("Downloading NIFTY data...")

    data = yf.download(
        "^NSEI",
        period="5d",
        interval="5m",
        progress=False,
        auto_adjust=False
    )

    if data.empty:
        print("No market data available")
        return

    if isinstance(data.columns, pd.MultiIndex):
        data.columns = data.columns.get_level_values(0)

    data = data.dropna()

    data["EMA9"] = data["Close"].ewm(span=9, adjust=False).mean()
    data["EMA21"] = data["Close"].ewm(span=21, adjust=False).mean()

    if len(data) < 3:
        print("Not enough candles")
        return

    candle = data.iloc[-2]
    previous = data.iloc[-3]

    candle_time = str(data.index[-2])

    if state["last_candle"] == candle_time:
        print("This candle has already been processed")
        return

    state["last_candle"] = candle_time

    price = float(candle["Close"])
    high = float(candle["High"])
    low = float(candle["Low"])

    previous_fast = float(previous["EMA9"])
    previous_slow = float(previous["EMA21"])
    fast = float(candle["EMA9"])
    slow = float(candle["EMA21"])

    bullish = previous_fast <= previous_slow and fast > slow
    bearish = previous_fast >= previous_slow and fast < slow

    print("NIFTY:", price)
    print("EMA 9:", round(fast, 2))
    print("EMA 21:", round(slow, 2))

    position = state["position"]

    if position:
        entry = position["entry"]
        direction = position["direction"]

        if direction == "BUY":
            sl = entry - STOP_LOSS
            tp = entry + TARGET

            if low <= sl:
                exit_price = sl
            elif high >= tp:
                exit_price = tp
            else:
                exit_price = None

        else:
            sl = entry + STOP_LOSS
            tp = entry - TARGET

            if high >= sl:
                exit_price = sl
            elif low <= tp:
                exit_price = tp
            else:
                exit_price = None

        if exit_price is not None:
            pnl = (
                exit_price - entry
                if direction == "BUY"
                else entry - exit_price
            )

            state["daily_loss"] += max(0, -pnl)
            state["position"] = None

            print("TRADE CLOSED:", direction)
            print("Entry:", entry)
            print("Exit:", exit_price)
            print("Paper P&L:", pnl)

    if (
        state["position"] is None
        and state["trades"] < MAX_TRADES
        and state["daily_loss"] < DAILY_LOSS_LIMIT
    ):
        if bullish:
            state["position"] = {
                "direction": "BUY",
                "entry": price
            }
            state["trades"] += 1
            print("PAPER BUY SIGNAL:", price)

        elif bearish:
            state["position"] = {
                "direction": "SELL",
                "entry": price
            }
            state["trades"] += 1
            print("PAPER SELL SIGNAL:", price)

    save_state(state)

    print("Trades today:", state["trades"])
    print("Daily loss:", state["daily_loss"])
    print("Robot execution completed")


if __name__ == "__main__":
    run_bot()
